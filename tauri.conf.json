{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shirley",
  "version": "0.0.2",
  "identifier": "com.shirley.desktop",
  "build": {
    "frontendDist": "src/interface/desktop/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shirley",
        "width": 1000,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
