<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime treats audio input as a separate capability: without this the signed
	     bundle is denied even though NSMicrophoneUsageDescription is present. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
