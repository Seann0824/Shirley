# Shirley 配置示例。复制为 `.env` 后按需修改（`.env` 已在 .gitignore 中，不会提交）。
#
# 优先级（低 → 高）：内置默认 < 全局 config.toml < 工作区 .shirley/config.toml < 环境变量。
# 也就是说，下面这些环境变量会覆盖配置文件里的同名项，兼容旧习惯。
# 详见 `src/settings.rs` 与 `Agent.md`。

# ---------------------------------------------------------------------------
# 模型服务（provider）
# ---------------------------------------------------------------------------

# 主模型协议：chat_completions / responses / anthropic_messages（默认 chat_completions）
LOCAL_PROTOCOL=chat_completions

# 必填：chat completions 完整地址（缺失不阻断启动，但会进入 /login 引导）
LOCAL_BASE_URL=http://127.0.0.1:8788/v1/chat/completions

# 可选：密钥。本地服务常不需要鉴权，留空即按“无鉴权”处理。
LOCAL_API_KEY=

# 可选：模型标识（默认 deepseek-v4.1-flash）
LOCAL_MODEL=deepseek-v4.1-flash

# 可选：模型列表接口，用于 /model 选择器；缺省时从 LOCAL_BASE_URL 推导。
# LOCAL_MODELS_URL=http://127.0.0.1:8788/v1/models

# 可选：上下文窗口 token 数（默认 52429）
# LOCAL_CONTEXT_WINDOW_TOKENS=52429

# 可选：工作区根目录（决定“这次在哪个项目跑”）。缺省为当前目录。
# 注意：它刻意不属于 settings，是会话级信息，供 bash / read_file / 系统提示词读取。
# SHIRLEY_WORKSPACE=/path/to/your/project

# ---------------------------------------------------------------------------
# 联网搜索工具（web_search，可选）
# 详见 `docs/web-search.md`。未配置 DEEPSEEK_API_KEY 时该工具不会被注册。
# ---------------------------------------------------------------------------

# 必填：搜索凭据（与主模型凭据相互独立）。留空则 web_search 工具不注册。
DEEPSEEK_API_KEY=

# 可选：搜索端点，必须是无凭据 / 无查询 / 无片段的 https URL
# DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1

# 可选：搜索模型（默认 deepseek-v4-flash）
# DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash

# 可选：Anthropic 协议版本头（默认 2023-06-01）
# DEEPSEEK_SEARCH_API_VERSION=2023-06-01

# 可选：单次搜索的 max_tokens（1..=32768，默认 4096）
# DEEPSEEK_SEARCH_MAX_TOKENS=4096

# 可选：服务端搜索次数上限（1..=10，默认 5）
# DEEPSEEK_SEARCH_MAX_USES=5

# 可选：归一化后保留的来源数（1..=20，默认 8）
# SHIRLEY_WEB_SEARCH_MAX_RESULTS=8

# 可选：搜索总超时，秒（5..=120，默认 30）
# SHIRLEY_WEB_SEARCH_TIMEOUT=30

# 可选：设为 0/false/no/off 显式关闭联网搜索（默认 true）
# SHIRLEY_WEB_SEARCH_ENABLED=true
